# MongoDB Atlas connection string and database name.
# Add your deployment IP to the Atlas Network Access allowlist.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/
MONGODB_DB_NAME=portfolio

# Server
PORT=5000
NODE_ENV=development

# Frontend URL for CORS. Use https://ranjitbhandary.me in production.
FRONTEND_URL=http://localhost:5173

# SMTP email notifications for the contact form.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
CONTACT_EMAIL_FROM=Portfolio Contact <your-email@gmail.com>
CONTACT_EMAIL_TO=ranjitbhandary15@gmail.com

# Cloudinary image storage for manually added project banners.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Private analytics dashboard authentication. Use long, unique values in production.
ANALYTICS_ADMIN_PASSWORD=change-this-to-a-long-unique-password
ANALYTICS_ADMIN_TOKEN_SECRET=change-this-to-a-separate-long-random-secret
ANALYTICS_CONSENT_VERSION=1
ANALYTICS_IP_RETENTION_DAYS=30
ANALYTICS_RETENTION_DAYS=365
